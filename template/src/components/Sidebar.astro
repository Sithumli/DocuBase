---
import type { SidebarProps } from '@/types';
import type { SidebarItem } from '@/types';

type Props = SidebarProps;

const { items, currentPath = "" } = Astro.props;
---

<nav class="space-y-1">
  {items.map((item) => (
    <div>
      <a
        href={item.href}
        class:list={[
          "block py-2 text-sm transition-colors text-gray-900 dark:text-gray-100 hover:text-gray-600 dark:hover:text-gray-300",
          currentPath === item.href && "font-medium"
        ]}
      >
        {item.title}
      </a>
      {item.items && item.items.length > 0 && (
        <div class="ml-4 space-y-1">
          {item.items.map((subItem) => (
            <a
              href={subItem.href}
              class:list={[
                "block py-1.5 text-sm transition-colors text-gray-900 dark:text-gray-100 hover:text-gray-600 dark:hover:text-gray-300",
                currentPath === subItem.href && "font-medium"
              ]}
            >
              {subItem.title}
            </a>
          ))}
        </div>
      )}
    </div>
  ))}
</nav>
