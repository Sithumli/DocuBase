---
---

<div class="search-container">
  <button
    id="search-trigger"
    type="button"
    class="flex items-center gap-2 w-40 lg:w-48 h-9 pl-3 pr-2 text-sm border-b border-gray-200 dark:border-gray-700 bg-transparent text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-400 hover:border-gray-300 dark:hover:border-gray-600 transition-colors cursor-pointer"
    aria-label="Open search"
  >
    <iconify-icon icon="mdi:magnify" width="16" height="16"></iconify-icon>
    <span class="flex-1 text-left">Search...</span>
    <kbd class="hidden lg:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-xs font-medium text-gray-400 dark:text-gray-500 bg-gray-100 dark:bg-gray-800 rounded">
      <span class="text-xs">⌘</span>K
    </kbd>
  </button>
</div>

<div
  id="search-modal"
  class="fixed inset-0 z-[100] hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
>
  <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" id="search-backdrop"></div>
  <div class="fixed inset-x-0 top-20 flex justify-center px-4">
    <div class="w-full max-w-2xl bg-white dark:bg-gray-900 rounded-xl shadow-2xl border border-gray-200 dark:border-gray-700 overflow-hidden">
      <div class="relative">
        <iconify-icon
          icon="mdi:magnify"
          class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500"
          width="20"
          height="20"
        ></iconify-icon>
        <input
          id="search-input"
          type="text"
          placeholder="Search documentation..."
          class="w-full h-14 pl-12 pr-12 text-base bg-transparent text-gray-900 dark:text-gray-100 placeholder:text-gray-400 dark:placeholder:text-gray-500 border-b border-gray-200 dark:border-gray-700 focus:outline-none"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        />
        <button
          id="search-close"
          type="button"
          class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300 transition-colors"
          aria-label="Close search"
        >
          <kbd class="inline-flex items-center px-1.5 py-0.5 text-xs font-medium text-gray-400 dark:text-gray-500 bg-gray-100 dark:bg-gray-800 rounded">
            ESC
          </kbd>
        </button>
      </div>
      <div id="search-results" class="max-h-96 overflow-y-auto">
        <div id="search-empty" class="p-8 text-center text-gray-500 dark:text-gray-400">
          <p class="text-sm">Start typing to search...</p>
        </div>
        <div id="search-loading" class="hidden p-8 text-center text-gray-500 dark:text-gray-400">
          <iconify-icon icon="mdi:loading" class="animate-spin" width="24" height="24"></iconify-icon>
        </div>
        <div id="search-no-results" class="hidden p-8 text-center text-gray-500 dark:text-gray-400">
          <iconify-icon icon="mdi:file-search-outline" width="48" height="48" class="mb-2 opacity-50"></iconify-icon>
          <p class="text-sm">No results found</p>
        </div>
        <ul id="search-results-list" class="divide-y divide-gray-100 dark:divide-gray-800"></ul>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    let pagefind = null;
    let searchTimeout = null;

    async function initPagefind() {
      if (pagefind) return pagefind;
      try {
        pagefind = await import('/pagefind/pagefind.js');
        await pagefind.init();
        return pagefind;
      } catch (e) {
        console.warn('Pagefind not available. Run "pnpm build" to generate the search index.');
        return null;
      }
    }

    function openModal() {
      const modal = document.getElementById('search-modal');
      const input = document.getElementById('search-input');
      if (!modal || !input) return;

      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      input.focus();
      initPagefind();
    }

    function closeModal() {
      const modal = document.getElementById('search-modal');
      const input = document.getElementById('search-input');
      const resultsList = document.getElementById('search-results-list');

      if (!modal) return;

      modal.classList.add('hidden');
      document.body.style.overflow = '';

      if (input) input.value = '';
      if (resultsList) resultsList.innerHTML = '';

      showElement('search-empty');
      hideElement('search-loading');
      hideElement('search-no-results');
    }

    function showElement(id) {
      const el = document.getElementById(id);
      if (el) el.classList.remove('hidden');
    }

    function hideElement(id) {
      const el = document.getElementById(id);
      if (el) el.classList.add('hidden');
    }

    async function performSearch(query) {
      const resultsList = document.getElementById('search-results-list');
      if (!resultsList) return;

      if (!query.trim()) {
        resultsList.innerHTML = '';
        showElement('search-empty');
        hideElement('search-loading');
        hideElement('search-no-results');
        return;
      }

      hideElement('search-empty');
      showElement('search-loading');
      hideElement('search-no-results');

      const pf = await initPagefind();
      if (!pf) {
        hideElement('search-loading');
        resultsList.innerHTML = '<li class="p-4 text-sm text-gray-500 dark:text-gray-400">Search index not available. Run build first.</li>';
        return;
      }

      const search = await pf.search(query);
      const results = await Promise.all(search.results.slice(0, 10).map(function(r) { return r.data(); }));

      hideElement('search-loading');

      if (results.length === 0) {
        resultsList.innerHTML = '';
        showElement('search-no-results');
        return;
      }

      hideElement('search-no-results');
      resultsList.innerHTML = results.map(function(result) {
        return '<li>' +
          '<a href="' + result.url + '" class="block p-4 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">' +
            '<div class="flex items-start gap-3">' +
              '<iconify-icon icon="mdi:file-document-outline" class="mt-0.5 text-gray-400 dark:text-gray-500 flex-shrink-0" width="18" height="18"></iconify-icon>' +
              '<div class="min-w-0 flex-1">' +
                '<h3 class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate">' +
                  (result.meta && result.meta.title ? result.meta.title : 'Untitled') +
                '</h3>' +
                '<p class="mt-1 text-xs text-gray-500 dark:text-gray-400 line-clamp-2">' +
                  (result.excerpt || '') +
                '</p>' +
              '</div>' +
            '</div>' +
          '</a>' +
        '</li>';
      }).join('');
    }

    function initSearch() {
      const trigger = document.getElementById('search-trigger');
      const backdrop = document.getElementById('search-backdrop');
      const closeBtn = document.getElementById('search-close');
      const input = document.getElementById('search-input');
      const resultsList = document.getElementById('search-results-list');

      if (trigger) trigger.addEventListener('click', openModal);
      if (backdrop) backdrop.addEventListener('click', closeModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);

      if (input) {
        input.addEventListener('input', function(e) {
          const query = e.target.value;
          if (searchTimeout) clearTimeout(searchTimeout);
          searchTimeout = setTimeout(function() { performSearch(query); }, 200);
        });
      }

      if (resultsList) {
        resultsList.addEventListener('click', function(e) {
          const link = e.target.closest('a');
          if (link) closeModal();
        });
      }

      document.addEventListener('keydown', function(e) {
        const modal = document.getElementById('search-modal');

        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          if (modal && modal.classList.contains('hidden')) {
            openModal();
          } else {
            closeModal();
          }
        }

        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
          closeModal();
        }
      });
    }

    initSearch();
    document.addEventListener('astro:page-load', initSearch);
  })();
</script>
