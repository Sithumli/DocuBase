---
import type { CalloutProps } from '@/types';
import { CALLOUT_STYLES, CALLOUT_DEFAULT_TITLES } from '@/types/styles';

const { type = 'note', title } = Astro.props as CalloutProps;

const currentStyle = CALLOUT_STYLES[type];
const displayTitle = title || CALLOUT_DEFAULT_TITLES[type];
---

<div class={`my-6 rounded-lg border p-4 bg-transparent ${currentStyle.border}`}>
  <div class="flex gap-3">
    <div class={`w-1 shrink-0 rounded-full ${currentStyle.line}`}></div>
    <div class="flex-1 min-w-0">
      <p class="font-semibold mb-1 text-gray-900 dark:text-gray-100">
        {displayTitle}
      </p>
      <div class="text-sm text-gray-800 dark:text-gray-200 [&>p]:m-0 [&>p:last-child]:mb-0">
        <slot />
      </div>
    </div>
  </div>
</div>
