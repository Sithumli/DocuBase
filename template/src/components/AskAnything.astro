---
import { CHAT_DEFAULTS, CHAT } from '@/types/constants';

interface Props {
  subtitle?: string;
  suggestions?: string[];
}

const {
  subtitle = CHAT_DEFAULTS.ASK_ANYTHING.subtitle,
  suggestions = CHAT_DEFAULTS.ASK_ANYTHING.suggestions
} = Astro.props;
---

<div class="w-full max-w-2xl mx-auto text-center">
  <p class="text-gray-600 dark:text-gray-400 mb-6">{subtitle}</p>

  <form id="ask-form" class="relative">
    <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden">
      <textarea
        id="ask-input"
        placeholder={CHAT_DEFAULTS.ASK_ANYTHING.placeholder}
        rows="2"
        class="w-full px-4 pt-4 pb-2 bg-transparent text-gray-900 dark:text-gray-100 placeholder:text-gray-400 dark:placeholder:text-gray-500 focus:outline-none text-base resize-none"
      ></textarea>

      <div class="flex items-center justify-end px-3 pb-3">
        <div class="flex items-center gap-1">
          <button
            id="ask-submit"
            type="submit"
            class="w-10 h-10 flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white rounded-full transition-all hover:scale-105 disabled:bg-gray-300 dark:disabled:bg-gray-600 disabled:cursor-not-allowed shadow-md ml-1"
            aria-label="Send message"
          >
            <iconify-icon icon="mdi:arrow-up" width="20" height="20"></iconify-icon>
          </button>
        </div>
      </div>
    </div>
  </form>

  <div class="flex flex-wrap justify-center gap-3 mt-4">
    {suggestions.map((suggestion) => (
      <button
        type="button"
        class="suggestion-chip flex items-center gap-2 px-3 py-2 text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-full transition-colors"
      >
        <iconify-icon icon="mdi:creation" width="16" height="16" class="text-purple-500"></iconify-icon>
        {suggestion}
      </button>
    ))}
  </div>
</div>

<script is:inline define:vars={{ TEXTAREA_MAX_HEIGHT: CHAT.TEXTAREA_MAX_HEIGHT }}>
  (function() {
    function generateUID() {
      return 'xxxx-xxxx-xxxx'.replace(/x/g, function() {
        return Math.floor(Math.random() * 16).toString(16);
      });
    }

    function navigateToChat(message) {
      if (!message.trim()) return;
      const uid = generateUID();
      sessionStorage.setItem(`chat-${uid}-initial`, message);
      window.location.href = `/chat/${uid}`;
    }

    function init() {
      const form = document.getElementById('ask-form');
      const input = document.getElementById('ask-input');
      const chips = document.querySelectorAll('.suggestion-chip');

      if (form && input) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          navigateToChat(input.value);
        });

        input.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            navigateToChat(input.value);
          }
        });

        input.addEventListener('input', function() {
          this.style.height = 'auto';
          this.style.height = Math.min(this.scrollHeight, TEXTAREA_MAX_HEIGHT) + 'px';
        });
      }

      chips.forEach(function(chip) {
        chip.addEventListener('click', function() {
          const text = chip.textContent.trim();
          navigateToChat(text);
        });
      });
    }

    init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
