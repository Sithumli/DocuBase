---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PageBanner from '@/components/PageBanner.astro';
import BlogCard from '@/components/BlogCard.astro';
import { calculateReadTime } from '@/utils/helpers';
import { WORDS_PER_MINUTE } from '@/types/constants';
import { getCleanSlug } from '@/utils';

const allTutorials = await getCollection('tutorials', ({ data }) => !data.draft);

const sortedTutorials = allTutorials
  .filter((tutorial) => tutorial.id !== 'index')
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999));

const currentYear = new Date().getFullYear();

const tutorialsByYear = {
  [currentYear]: sortedTutorials
};
---

<BaseLayout title="Tutorials" description="Step-by-step tutorials to help you learn DocuBase">
  <Header currentPath="/tutorials" />
  <PageBanner image="https://raw.githubusercontent.com/Sithumli/DocuBase/main/assets/TutBanner.webp" alt="Tutorials" />

    <main class="flex-1">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="max-w-3xl mx-auto">
          {Object.entries(tutorialsByYear)
            .sort(([a], [b]) => Number(b) - Number(a))
            .map(([year, tutorials]) => (
              <div class="flex gap-12 mb-12">
                <h2 class="text-2xl font-bold text-gray-900 shrink-0 sticky top-24 self-start">
                  {year}
                </h2>

                <div class="flex-1 space-y-4">
                  {tutorials.map((tutorial) => (
                    <BlogCard
                      title={tutorial.data.title}
                      description={tutorial.data.description || ''}
                      date={`Step ${tutorial.data.order}`}
                      readTime={`${calculateReadTime(tutorial.body || '', WORDS_PER_MINUTE)} min read`}
                      href={`/tutorials/${getCleanSlug(tutorial.id)}`}
                    />
                  ))}
                </div>
              </div>
            ))
          }

          {sortedTutorials.length === 0 && (
            <p class="text-center text-gray-600">No tutorials yet. Check back soon!</p>
          )}
        </div>
      </div>
    </main>

    <Footer />
</BaseLayout>
