---
import '../styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import ReadTime from '@/components/ReadTime.astro';
import type { DocsLayoutProps } from '@/types';
import { SITE_TITLE } from '@/types/constants';

interface ExtendedDocsLayoutProps extends DocsLayoutProps {
  entry?: any;
  headings?: any[];
  Content?: any;
}

const { title: propTitle, description: propDescription, type = 'docs', entry, headings = [], Content } = Astro.props as ExtendedDocsLayoutProps;
const siteTitle = SITE_TITLE;

const isContentBased = !!entry && !!headings && !!Content;

let title = propTitle;
let description = propDescription;
let leftTocItems: any[] = [];
let rightTocItems: any[] = [];
let readTime = 0;
let breadcrumbItems: any[] = [];

if (isContentBased) {
  title = entry.data.title;
  description = entry.data.description;

  leftTocItems = headings
    .filter((heading) => heading.depth <= 3)
    .map((heading) => ({
      title: heading.text,
      href: `#${heading.slug}`,
      depth: heading.depth,
    }));

  rightTocItems = [];
  let currentH2: any = null;

  headings.forEach((heading) => {
    if (heading.depth === 2) {
      currentH2 = {
        title: heading.text,
        href: `#${heading.slug}`,
        depth: 2,
        children: []
      };
      rightTocItems.push(currentH2);
    } else if (heading.depth === 3 && currentH2) {
      currentH2.children.push({
        title: heading.text,
        href: `#${heading.slug}`,
        depth: 3,
      });
    }
  });

  const wordsPerMinute = 200;
  const content = entry.body;
  const words = content.trim().split(/\s+/).length;
  readTime = Math.ceil(words / wordsPerMinute);

  const typeLabel = type.charAt(0).toUpperCase() + type.slice(1);
  breadcrumbItems = [
    { label: typeLabel, href: `/${type}` },
    { label: entry.data.title },
  ];
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description || `${title} - ${siteTitle}`} />
    <title>{title} | {siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-gray-900">
    <Header currentPath={Astro.url.pathname} />

    <div class="flex-1 container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex gap-8 py-12 layout-container">
        {isContentBased ? (
          <>
            <aside class="hidden lg:block shrink-0 sidebar-slot">
              <div class="sticky top-28">
                <TableOfContents items={leftTocItems} title={entry.data.title} showBorder={false} centered={false} collapsible={true} />
              </div>
            </aside>

            <main class="flex-1 min-w-0 main-slot">
              <Breadcrumb items={breadcrumbItems} />

              <div class="mt-4">
                <h1 class="text-4xl font-bold text-gray-900 mb-2">{entry.data.title}</h1>
                {entry.data.description && (
                  <p class="text-lg text-gray-600 mb-4">{entry.data.description}</p>
                )}

                <div class="flex items-center gap-4 text-sm text-gray-500 mb-8">
                  {entry.data.pubDate && (
                    <time datetime={entry.data.pubDate.toISOString()}>
                      {entry.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                      })}
                    </time>
                  )}
                  {entry.data.author && <span>by {entry.data.author}</span>}
                  <ReadTime minutes={readTime} />
                </div>

                {entry.data.tags && entry.data.tags.length > 0 && (
                  <div class="flex gap-2 mb-8">
                    {entry.data.tags.map((tag: string) => (
                      <span class="px-3 py-1 text-xs bg-gray-100 text-gray-700 rounded-full">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}

                <article class="prose prose-gray max-w-none">
                  <Content />
                </article>
              </div>
            </main>

            <aside class="hidden xl:block w-48 shrink-0">
              <div class="sticky top-28">
                <TableOfContents items={rightTocItems} nested={true} />
              </div>
            </aside>
          </>
        ) : (
          <>
            <aside class="hidden lg:block shrink-0 sidebar-slot">
              <div class="sticky top-28">
                <slot name="sidebar" />
              </div>
            </aside>

            <main class="flex-1 min-w-0 main-slot">
              <slot name="breadcrumb" />
              <article class="max-w-none">
                <slot />
              </article>
            </main>

            <aside class="hidden xl:block w-48 shrink-0">
              <div class="sticky top-28">
                <slot name="toc" />
              </div>
            </aside>
          </>
        )}
      </div>
    </div>

    <Footer />

    <style>
      .sidebar-slot {
        transition: margin-right 0.4s ease-in-out;
      }

      .sidebar-slot.collapsed {
        margin-right: -12rem;
      }

      .main-slot {
        transition: margin-left 0.4s ease-in-out;
      }
    </style>

    <script>
      // Collapsible sidebar functionality with fallback for older browsers
      (function() {
        const sidebarSlot = document.querySelector('.sidebar-slot');
        const tocBox = document.querySelector('.toc-collapsible-box');

        if (!sidebarSlot || !tocBox) return;

        // Initially collapse the sidebar
        sidebarSlot.classList.add('collapsed');

        // Handle hover events
        tocBox.addEventListener('mouseenter', () => {
          sidebarSlot.classList.remove('collapsed');
        });

        tocBox.addEventListener('mouseleave', () => {
          sidebarSlot.classList.add('collapsed');
        });
      })();
    </script>
  </body>
</html>
