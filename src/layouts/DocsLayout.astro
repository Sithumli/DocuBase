---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'docs' | 'blog' | 'tutorials';
}

const { title, description, type = 'docs' } = Astro.props;
const siteTitle = 'DocuBase';

const typeLabels = {
  docs: 'Documentation',
  blog: 'Blog',
  tutorials: 'Tutorials',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description || `${title} - ${siteTitle}`} />
    <title>{title} | {siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100">
    <header class="sticky top-0 z-50 w-full border-b border-gray-200 dark:border-gray-800 bg-white/95 dark:bg-gray-900/95 backdrop-blur supports-[backdrop-filter]:bg-white/60">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <div class="flex items-center gap-6">
            <a href="/" class="flex items-center gap-2 font-semibold text-lg">
              {siteTitle}
            </a>
            <nav class="hidden md:flex items-center gap-6">
              <a
                href="/docs"
                class:list={[
                  'text-sm font-medium transition-colors hover:text-primary-600',
                  type === 'docs' ? 'text-primary-600' : 'text-gray-600 dark:text-gray-400',
                ]}
              >
                Docs
              </a>
              <a
                href="/blog"
                class:list={[
                  'text-sm font-medium transition-colors hover:text-primary-600',
                  type === 'blog' ? 'text-primary-600' : 'text-gray-600 dark:text-gray-400',
                ]}
              >
                Blog
              </a>
              <a
                href="/tutorials"
                class:list={[
                  'text-sm font-medium transition-colors hover:text-primary-600',
                  type === 'tutorials' ? 'text-primary-600' : 'text-gray-600 dark:text-gray-400',
                ]}
              >
                Tutorials
              </a>
            </nav>
          </div>
          <div class="flex items-center gap-4">
            <a
              href="https://github.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </header>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex gap-8 py-8">
        <aside class="hidden lg:block w-64 shrink-0">
          <nav class="sticky top-24 space-y-2">
            <slot name="sidebar" />
          </nav>
        </aside>

        <main class="flex-1 min-w-0">
          <div class="mb-4">
            <span class="text-sm text-primary-600 font-medium">{typeLabels[type]}</span>
          </div>
          <article class="prose max-w-none">
            <h1>{title}</h1>
            {description && <p class="text-xl text-gray-600 dark:text-gray-400 mt-2 mb-8">{description}</p>}
            <slot />
          </article>
        </main>

        <aside class="hidden xl:block w-56 shrink-0">
          <nav class="sticky top-24">
            <slot name="toc" />
          </nav>
        </aside>
      </div>
    </div>
  </body>
</html>
