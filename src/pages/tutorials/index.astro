---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import DocNav from '@/components/DocNav.astro';
import { getCleanSlug } from '@/utils';

const tutorials = await getCollection('tutorials');
const indexTutorial = tutorials.find(tutorial => tutorial.id === 'index');

if (!indexTutorial) {
  throw new Error('Index tutorial not found');
}

const { Content, headings } = await render(indexTutorial);

const sortedTutorials = tutorials
  .filter((t) => t.id !== 'index')
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999));

const tutorialPages = sortedTutorials.map((t) => ({
  title: t.data.title,
  href: `/tutorials/${getCleanSlug(t.id)}`,
  depth: 2,
}));

const nextTutorial = sortedTutorials[0];
const nextNav = nextTutorial ? {
  label: nextTutorial.data.title,
  href: `/tutorials/${getCleanSlug(nextTutorial.id)}`,
} : undefined;
---

<DocsLayout entry={indexTutorial} headings={headings} Content={Content} type="tutorials">
  <div slot="sidebar">
    <TableOfContents items={tutorialPages} title="Tutorials" showBorder={false} collapsible={true} isPageNav={true} />
  </div>
  {nextNav && (
    <div slot="footer">
      <DocNav next={nextNav} />
    </div>
  )}
</DocsLayout>
