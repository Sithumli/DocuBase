---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import BottomNav from '@/components/BottomNav.astro';
import { getTutorialsNavigation } from '@/utils/navigation';
import { getCleanSlug } from '@/utils';

export async function getStaticPaths() {
  const cleanSlug = (id: string) => id.replace(/\/index$/, '');
  const tutorials = await getCollection('tutorials', ({ data }) => !data.draft);

  return tutorials
    .filter((entry) => entry.id !== 'index')
    .map((entry) => ({
      params: { slug: cleanSlug(entry.id) },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const allTutorials = await getCollection('tutorials', ({ data }) => !data.draft);
const sortedTutorials = allTutorials
  .filter((t) => t.id !== 'index')
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999));

const tutorialPages = sortedTutorials.map((t) => ({
  title: t.data.title,
  href: `/tutorials/${getCleanSlug(t.id)}`,
  depth: 2,
}));

const navData = await getTutorialsNavigation(getCleanSlug(entry.id));
---

<DocsLayout entry={entry} headings={headings} Content={Content} type="tutorials">
  <div slot="sidebar">
    <TableOfContents items={tutorialPages} title="Tutorials" showBorder={false} collapsible={true} isPageNav={true} />
  </div>
  <div slot="footer">
    <BottomNav nav={navData} />
  </div>
</DocsLayout>
