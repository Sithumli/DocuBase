---
import '../styles/global.css';

const siteTitle = 'DocuBase';
const siteDescription = 'A general-purpose documentation template for web projects';

const features = [
  {
    title: 'Content-First',
    description: 'Write documentation in MDX with full component support',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`,
  },
  {
    title: 'Framework-Agnostic',
    description: 'Works with any UI library or framework you choose',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
  },
  {
    title: 'Multiple Content Types',
    description: 'Support for docs, blog posts, tutorials, and more',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>`,
  },
  {
    title: 'Static Deployment',
    description: 'Deploy anywhere: Cloudflare Pages, GitHub Pages, Vercel',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>`,
  },
];

const contentTypes = [
  {
    title: 'Documentation',
    description: 'Technical documentation with sidebar navigation',
    href: '/docs',
    color: 'text-blue-600 dark:text-blue-400',
  },
  {
    title: 'Blog',
    description: 'Posts and articles with tags and dates',
    href: '/blog',
    color: 'text-green-600 dark:text-green-400',
  },
  {
    title: 'Tutorials',
    description: 'Step-by-step guides with difficulty levels',
    href: '/tutorials',
    color: 'text-purple-600 dark:text-purple-400',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteDescription} />
    <title>{siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100">
    <header class="border-b border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <a href="/" class="flex items-center gap-2 font-semibold text-lg">
            {siteTitle}
          </a>
          <nav class="flex items-center gap-6">
            <a href="/docs" class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-primary-600 transition-colors">
              Docs
            </a>
            <a href="/blog" class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-primary-600 transition-colors">
              Blog
            </a>
            <a href="/tutorials" class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-primary-600 transition-colors">
              Tutorials
            </a>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <!-- Hero Section -->
      <section class="py-20 sm:py-32">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight">
            {siteTitle}
          </h1>
          <p class="mt-6 text-lg sm:text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
            {siteDescription}. Built with Astro, MDX, and Tailwind CSS.
          </p>
          <div class="mt-10 flex flex-wrap justify-center gap-4">
            <a
              href="/docs"
              class="inline-flex items-center px-6 py-3 rounded-lg bg-primary-600 text-white font-medium hover:bg-primary-700 transition-colors"
            >
              Get Started
            </a>
            <a
              href="https://github.com"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center px-6 py-3 rounded-lg border border-gray-300 dark:border-gray-700 font-medium hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
            >
              View on GitHub
            </a>
          </div>
        </div>
      </section>

      <!-- Features Section -->
      <section class="py-16 bg-gray-50 dark:bg-gray-800/50">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-2xl sm:text-3xl font-bold text-center mb-12">Features</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
            {
              features.map((feature) => (
                <div class="text-center">
                  <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-400 mb-4">
                    <Fragment set:html={feature.icon} />
                  </div>
                  <h3 class="text-lg font-semibold mb-2">{feature.title}</h3>
                  <p class="text-gray-600 dark:text-gray-400">{feature.description}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Content Types Section -->
      <section class="py-16">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-2xl sm:text-3xl font-bold text-center mb-12">Content Types</h2>
          <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
            {
              contentTypes.map((type) => (
                <a
                  href={type.href}
                  class="block p-6 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-primary-500 dark:hover:border-primary-500 transition-colors"
                >
                  <h3 class={`text-lg font-semibold mb-2 ${type.color}`}>{type.title}</h3>
                  <p class="text-gray-600 dark:text-gray-400">{type.description}</p>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Quick Start Section -->
      <section class="py-16 bg-gray-50 dark:bg-gray-800/50">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-2xl sm:text-3xl font-bold text-center mb-8">Quick Start</h2>
          <div class="max-w-2xl mx-auto">
            <pre class="bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto"><code># Clone the template
git clone https://github.com/your-repo/docubase.git

# Install dependencies
pnpm install

# Start development server
pnpm dev</code></pre>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-gray-200 dark:border-gray-800 py-8">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-center text-sm text-gray-600 dark:text-gray-400">
          Built with Astro. Documentation template.
        </p>
      </div>
    </footer>
  </body>
</html>
