---
import { getCollection } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

const docs = await getCollection('docs', ({ data }) => !data.draft);

// Group docs by category
const groupedDocs = docs.reduce(
  (acc, doc) => {
    const category = doc.data.category || 'General';
    if (!acc[category]) {
      acc[category] = [];
    }
    acc[category].push(doc);
    return acc;
  },
  {} as Record<string, typeof docs>
);

// Sort docs within each category by order
Object.keys(groupedDocs).forEach((category) => {
  groupedDocs[category].sort((a, b) => (a.data.order || 999) - (b.data.order || 999));
});
---

<DocsLayout title="Documentation" description="Browse all documentation" type="docs">
  {
    Object.entries(groupedDocs).length > 0 ? (
      Object.entries(groupedDocs).map(([category, categoryDocs]) => (
        <section class="mb-8">
          <h2 class="text-xl font-semibold mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">
            {category}
          </h2>
          <div class="grid gap-4">
            {categoryDocs.map((doc) => (
              <a
                href={`/docs/${doc.id}`}
                class="block p-4 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-primary-500 dark:hover:border-primary-500 transition-colors"
              >
                <h3 class="font-medium text-lg">{doc.data.title}</h3>
                {doc.data.description && (
                  <p class="text-gray-600 dark:text-gray-400 mt-1 text-sm">{doc.data.description}</p>
                )}
              </a>
            ))}
          </div>
        </section>
      ))
    ) : (
      <p class="text-gray-600 dark:text-gray-400">No documentation pages yet. Add MDX files to <code>src/content/docs/</code> to get started.</p>
    )
  }
</DocsLayout>
