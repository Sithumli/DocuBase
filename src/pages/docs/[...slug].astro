---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import BottomNav from '@/components/BottomNav.astro';
import { getDocsNavigation } from '@/utils/navigation';

function getCleanSlug(id: string) {
  return id.replace(/\/index$/, '');
}

export async function getStaticPaths() {
  const cleanSlug = (id: string) => id.replace(/\/index$/, '');
  const docs = await getCollection('docs', ({ data }) => !data.draft);

  // Filter out the main index (handled by docs/index.astro)
  return docs
    .filter((entry) => entry.id !== 'index')
    .map((entry) => ({
      params: { slug: cleanSlug(entry.id) },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Get all docs for sidebar navigation (exclude main index)
const allDocs = await getCollection('docs', ({ data }) => !data.draft);
const sortedDocs = allDocs
  .filter((doc) => doc.id !== 'index')
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999));

const docsPages = sortedDocs.map((doc) => ({
  title: doc.data.title,
  href: `/docs/${getCleanSlug(doc.id)}`,
  depth: 2,
}));

// Get navigation data for bottom nav
const navData = await getDocsNavigation(getCleanSlug(entry.id));
---

<DocsLayout entry={entry} headings={headings} Content={Content} type="docs">
  <div slot="sidebar">
    <TableOfContents items={docsPages} title="Documentation" showBorder={false} collapsible={true} isPageNav={true} />
  </div>
  <div slot="footer">
    <BottomNav nav={navData} />
  </div>
</DocsLayout>
