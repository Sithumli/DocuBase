---
import type { CalloutProps } from '@/types';

const { type = 'note', title } = Astro.props as CalloutProps;

const styles = {
  note: {
    border: 'border-gray-400 dark:border-gray-500',
    line: 'bg-gray-400 dark:bg-gray-500',
  },
  tip: {
    border: 'border-green-500 dark:border-green-500',
    line: 'bg-green-500',
  },
  warning: {
    border: 'border-yellow-500 dark:border-yellow-500',
    line: 'bg-yellow-500',
  },
  danger: {
    border: 'border-red-500 dark:border-red-500',
    line: 'bg-red-500',
  },
  info: {
    border: 'border-blue-500 dark:border-blue-500',
    line: 'bg-blue-500',
  },
};

const defaultTitles = {
  note: 'Note',
  tip: 'Tip',
  warning: 'Warning',
  danger: 'Danger',
  info: 'Info',
};

const currentStyle = styles[type];
const typeLabel = defaultTitles[type];
---

<div class={`my-6 rounded-lg border p-4 bg-transparent ${currentStyle.border}`}>
  <div class="flex gap-3">
    <div class={`w-1 shrink-0 rounded-full ${currentStyle.line}`}></div>
    <div class="flex-1 min-w-0">
      <p class="font-semibold mb-1 text-gray-900 dark:text-gray-100">
        {typeLabel}{title && <span>: {title}</span>}
      </p>
      <div class="text-sm text-gray-800 dark:text-gray-200 [&>p]:m-0 [&>p:last-child]:mb-0">
        <slot />
      </div>
    </div>
  </div>
</div>
