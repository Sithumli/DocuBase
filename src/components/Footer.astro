---
import type { FooterProps } from '@/types';
import { GITHUB_URL } from '@/types/constants';

type Props = FooterProps;

const { githubUrl = GITHUB_URL } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-gray-200 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center gap-4 py-6 md:flex-row md:h-16 md:py-0 md:justify-between">
      <a href="/" class="font-semibold text-lg">DocuBase</a>

      <p class="text-xs text-gray-500 text-center order-last md:order-none">
        {currentYear} DocuBase All Rights Reserved
      </p>

      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-600 hover:text-gray-900 transition-colors"
        aria-label="GitHub"
      >
        <iconify-icon icon="mdi:github" width="20" height="20"></iconify-icon>
      </a>
    </div>
  </div>
</footer>

<script>
  import 'iconify-icon';
</script>
