---
import type { TabsProps } from '@/types';
import { hashString } from '@/utils';
import { DEFAULTS } from '@/types/constants';

const { labels, defaultIndex = DEFAULTS.TABS.defaultIndex, id } = Astro.props as TabsProps;

const tabsId = id || `tabs-${hashString(labels.join('-'))}`;
---

<div class="my-6" data-tabs={tabsId}>
  <div class="flex gap-1 border-b border-gray-200 dark:border-gray-700" role="tablist">
    {labels.map((label, index) => (
      <button
        type="button"
        role="tab"
        tabindex={index === defaultIndex ? 0 : -1}
        class:list={[
          'tab-button px-4 py-2 text-sm font-medium rounded-t-lg transition-colors',
          'hover:bg-gray-50 dark:hover:bg-gray-800',
          'focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-inset',
          index === defaultIndex
            ? 'text-primary-600 dark:text-primary-400 border-b-2 border-primary-600 dark:border-primary-400 -mb-px bg-white dark:bg-gray-900'
            : 'text-gray-600 dark:text-gray-400',
        ]}
        data-tab-index={index}
        aria-selected={index === defaultIndex}
        id={`${tabsId}-tab-${index}`}
        aria-controls={`${tabsId}-panel-${index}`}
      >
        {label}
      </button>
    ))}
  </div>
  <div class="tab-panels mt-4">
    <slot />
  </div>
</div>

<script>
  (function() {
    // Guard to prevent duplicate listeners
    if ((window as any).__tabsInitialized) return;
    (window as any).__tabsInitialized = true;

    function activateTab(container: Element, index: number) {
      const tabs = Array.from(container.querySelectorAll('.tab-button')) as HTMLElement[];
      const panelsContainer = container.querySelector('.tab-panels');
      if (!panelsContainer || !tabs.length) return;

      const panels = Array.from(panelsContainer.children) as HTMLElement[];

      tabs.forEach((t, i) => {
        if (i === index) {
          t.classList.add('text-primary-600', 'dark:text-primary-400', 'border-b-2', 'border-primary-600', 'dark:border-primary-400', '-mb-px', 'bg-white', 'dark:bg-gray-900');
          t.classList.remove('text-gray-600', 'dark:text-gray-400');
          t.setAttribute('aria-selected', 'true');
          t.setAttribute('tabindex', '0');
          t.focus();
        } else {
          t.classList.remove('text-primary-600', 'dark:text-primary-400', 'border-b-2', 'border-primary-600', 'dark:border-primary-400', '-mb-px', 'bg-white', 'dark:bg-gray-900');
          t.classList.add('text-gray-600', 'dark:text-gray-400');
          t.setAttribute('aria-selected', 'false');
          t.setAttribute('tabindex', '-1');
        }
      });

      panels.forEach((panel, i) => {
        panel.classList.toggle('hidden', i !== index);
      });
    }

    // Click handler
    document.addEventListener('click', (e) => {
      const tab = (e.target as HTMLElement).closest('.tab-button');
      if (!tab) return;

      const container = tab.closest('[data-tabs]');
      if (!container) return;

      const index = parseInt(tab.getAttribute('data-tab-index') || '0', 10);
      activateTab(container, index);
    });

    // Keyboard navigation handler
    document.addEventListener('keydown', (e) => {
      const tab = (e.target as HTMLElement).closest('.tab-button');
      if (!tab) return;

      const container = tab.closest('[data-tabs]');
      if (!container) return;

      const tabs = Array.from(container.querySelectorAll('.tab-button')) as HTMLElement[];
      const currentIndex = parseInt(tab.getAttribute('data-tab-index') || '0', 10);
      let newIndex = currentIndex;

      switch (e.key) {
        case 'ArrowLeft':
          newIndex = currentIndex > 0 ? currentIndex - 1 : tabs.length - 1;
          e.preventDefault();
          break;
        case 'ArrowRight':
          newIndex = currentIndex < tabs.length - 1 ? currentIndex + 1 : 0;
          e.preventDefault();
          break;
        case 'Home':
          newIndex = 0;
          e.preventDefault();
          break;
        case 'End':
          newIndex = tabs.length - 1;
          e.preventDefault();
          break;
        default:
          return;
      }

      activateTab(container, newIndex);
    });

    function initTabPanels() {
      document.querySelectorAll('[data-tabs]').forEach((container) => {
        const panelsContainer = container.querySelector('.tab-panels');
        if (!panelsContainer) return;
        Array.from(panelsContainer.children).forEach((panel, index) => {
          (panel as HTMLElement).classList.toggle('hidden', index !== 0);
        });
      });
    }

    initTabPanels();
    document.addEventListener('astro:page-load', initTabPanels);
  })();
</script>
