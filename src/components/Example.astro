---
import type { ExampleProps } from '@/types';

const { title, description } = Astro.props as ExampleProps;
---

<div class="my-6 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
  {(title || description) && (
    <div class="px-4 py-3 bg-gray-50 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
      {title && <p class="font-medium text-sm">{title}</p>}
      {description && <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">{description}</p>}
    </div>
  )}
  <div class="p-4">
    <slot />
  </div>
</div>
