---
/**
 * CodeGroup - A tabbed code block component
 *
 * @prop {string[]} labels - Tab labels (must match number of slotted children)
 * @prop {string} [id] - Optional unique ID for the group
 *
 * Usage:
 * <CodeGroup labels={["JavaScript", "TypeScript"]}>
 *   <div>JS code here</div>
 *   <div>TS code here</div>
 * </CodeGroup>
 *
 * Note: The number of labels must match the number of direct children in the slot.
 */
import type { CodeGroupProps } from '@/types';
import { hashString } from '@/utils';

const { labels, id } = Astro.props as CodeGroupProps;

const groupId = id || `code-group-${hashString(labels.join('-'))}`;
---

<div class="my-6 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden" data-code-group={groupId}>
  <div class="flex border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800" role="tablist">
    {labels.map((label, index) => (
      <button
        type="button"
        role="tab"
        tabindex={index === 0 ? 0 : -1}
        class:list={[
          'code-group-tab px-4 py-2 text-sm font-medium transition-colors',
          'hover:bg-gray-100 dark:hover:bg-gray-700',
          'focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-inset',
          index === 0
            ? 'text-primary-600 dark:text-primary-400 border-b-2 border-primary-600 dark:border-primary-400 -mb-px bg-white dark:bg-gray-900'
            : 'text-gray-600 dark:text-gray-400',
        ]}
        data-tab-index={index}
        aria-selected={index === 0}
      >
        {label}
      </button>
    ))}
  </div>
  <div class="code-group-panels [&>div]:hidden [&>div.active]:block [&_pre]:my-0 [&_pre]:rounded-none [&_pre]:border-0">
    <slot />
  </div>
</div>

<script>
  (function() {
    // Guard to prevent duplicate listeners
    if ((window as any).__codeGroupInitialized) return;
    (window as any).__codeGroupInitialized = true;

    function activateCodeGroupTab(group: Element, index: number) {
      const tabs = Array.from(group.querySelectorAll('.code-group-tab')) as HTMLElement[];
      const panels = group.querySelector('.code-group-panels');
      if (!panels || !tabs.length) return;

      const panelDivs = Array.from(panels.children) as HTMLElement[];

      tabs.forEach((t, i) => {
        if (i === index) {
          t.classList.add('text-primary-600', 'dark:text-primary-400', 'border-b-2', 'border-primary-600', 'dark:border-primary-400', '-mb-px', 'bg-white', 'dark:bg-gray-900');
          t.classList.remove('text-gray-600', 'dark:text-gray-400');
          t.setAttribute('aria-selected', 'true');
          t.setAttribute('tabindex', '0');
          t.focus();
        } else {
          t.classList.remove('text-primary-600', 'dark:text-primary-400', 'border-b-2', 'border-primary-600', 'dark:border-primary-400', '-mb-px', 'bg-white', 'dark:bg-gray-900');
          t.classList.add('text-gray-600', 'dark:text-gray-400');
          t.setAttribute('aria-selected', 'false');
          t.setAttribute('tabindex', '-1');
        }
      });

      panelDivs.forEach((panel, i) => {
        panel.classList.toggle('active', i === index);
      });
    }

    // Click handler
    document.addEventListener('click', (e) => {
      const tab = (e.target as HTMLElement).closest('.code-group-tab');
      if (!tab) return;

      const group = tab.closest('[data-code-group]');
      if (!group) return;

      const index = parseInt(tab.getAttribute('data-tab-index') || '0', 10);
      activateCodeGroupTab(group, index);
    });

    // Keyboard navigation handler
    document.addEventListener('keydown', (e) => {
      const tab = (e.target as HTMLElement).closest('.code-group-tab');
      if (!tab) return;

      const group = tab.closest('[data-code-group]');
      if (!group) return;

      const tabs = Array.from(group.querySelectorAll('.code-group-tab')) as HTMLElement[];
      const currentIndex = parseInt(tab.getAttribute('data-tab-index') || '0', 10);
      let newIndex = currentIndex;

      switch (e.key) {
        case 'ArrowLeft':
          newIndex = currentIndex > 0 ? currentIndex - 1 : tabs.length - 1;
          e.preventDefault();
          break;
        case 'ArrowRight':
          newIndex = currentIndex < tabs.length - 1 ? currentIndex + 1 : 0;
          e.preventDefault();
          break;
        case 'Home':
          newIndex = 0;
          e.preventDefault();
          break;
        case 'End':
          newIndex = tabs.length - 1;
          e.preventDefault();
          break;
        default:
          return;
      }

      activateCodeGroupTab(group, newIndex);
    });

    function initCodeGroupPanels() {
      document.querySelectorAll('[data-code-group]').forEach((group) => {
        const tabs = group.querySelectorAll('.code-group-tab');
        const panels = group.querySelector('.code-group-panels');
        if (!panels) return;

        const panelCount = panels.children.length;
        const tabCount = tabs.length;

        // Validate that tabs and panels match
        if (tabCount !== panelCount && import.meta.env.DEV) {
          console.warn(
            `[CodeGroup] Mismatch: ${tabCount} labels but ${panelCount} content panels in group "${group.getAttribute('data-code-group')}". Each label should have a corresponding content block.`
          );
        }

        const firstPanel = panels.children[0] as HTMLElement;
        if (firstPanel) firstPanel.classList.add('active');
      });
    }

    initCodeGroupPanels();
    document.addEventListener('astro:page-load', initCodeGroupPanels);
  })();
</script>
