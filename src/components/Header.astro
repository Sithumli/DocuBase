---
import type { HeaderProps } from '@/types';
import { NAV_LINKS, THEME, INIT_FLAGS } from '@/types/constants';

const { currentPath = "" } = Astro.props as HeaderProps;

const navLinks = NAV_LINKS;
---

<header class="sticky top-4 z-50 w-full">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative flex h-14 items-center justify-between bg-white/50 backdrop-blur-xl border border-white/30 shadow-lg shadow-black/5 rounded-full px-6">
      <a href="/" class="font-semibold text-lg">DocuBase</a>

      <nav class="absolute left-1/2 -translate-x-1/2 hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-sm font-medium transition-colors hover:text-gray-900",
              currentPath === link.href || (link.href !== "/" && (currentPath === link.href || currentPath.startsWith(link.href + "/")))
                ? "text-gray-900"
                : "text-gray-600",
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-4">
        <div class="relative hidden sm:block">
          <input
            type="text"
            placeholder="Search..."
            disabled
            title="Search coming soon"
            class="w-40 lg:w-48 h-9 pl-3 pr-8 text-sm border-b border-gray-200 bg-transparent focus:outline-none focus:border-cyan-500 disabled:opacity-50 disabled:cursor-not-allowed"
          />
          <iconify-icon icon="mdi:magnify" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400" width="16" height="16"></iconify-icon>
        </div>

        <button
          id="theme-toggle"
          class="p-2 text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100 transition-colors"
          aria-label="Toggle theme"
        >
          <iconify-icon icon="mdi:weather-sunny" class="hidden dark:block" width="20" height="20"></iconify-icon>
          <iconify-icon icon="mdi:weather-night" class="block dark:hidden" width="20" height="20"></iconify-icon>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  import 'iconify-icon';

  const THEME_STORAGE_KEY = 'theme';
  const THEME_DARK = 'dark';
  const THEME_LIGHT = 'light';

  (function() {
    if ((window as any).__themeToggleInitialized) return;
    (window as any).__themeToggleInitialized = true;

    function getThemePreference(): 'dark' | 'light' {
      const stored = localStorage.getItem(THEME_STORAGE_KEY);
      if (stored === THEME_DARK || stored === THEME_LIGHT) return stored;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? THEME_DARK : THEME_LIGHT;
    }

    function setTheme(theme: 'dark' | 'light') {
      document.documentElement.classList.toggle(THEME_DARK, theme === THEME_DARK);
      localStorage.setItem(THEME_STORAGE_KEY, theme);
    }

    function initTheme() {
      setTheme(getThemePreference());
    }

    document.addEventListener('click', (e) => {
      const toggle = (e.target as HTMLElement).closest('#theme-toggle');
      if (!toggle) return;

      const isDark = document.documentElement.classList.contains(THEME_DARK);
      setTheme(isDark ? THEME_LIGHT : THEME_DARK);
    });

    initTheme();
    document.addEventListener('astro:page-load', initTheme);
  })();
</script>
