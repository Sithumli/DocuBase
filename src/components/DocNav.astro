---
import type { DocNavProps } from '@/types';

const { prev, next } = Astro.props as DocNavProps;
---

<nav class="flex items-center justify-between pt-8 mt-8 border-t border-gray-200">
  <div>
    {prev && (
      <a href={prev.href} class="text-sm text-gray-500 hover:text-gray-900 transition-colors">
        Previous
      </a>
    )}
  </div>
  <div>
    {next && (
      <a href={next.href} class="flex items-center gap-1 text-sm text-gray-900 font-medium hover:text-gray-700 transition-colors">
        {next.label}
        <iconify-icon icon="mdi:chevron-right" width="16" height="16"></iconify-icon>
      </a>
    )}
  </div>
</nav>

<script>
  import 'iconify-icon';
</script>
