{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["template/src/*"],
      "@/components": ["template/src/components"],
      "@/types": ["template/src/types"],
      "@/utils": ["template/src/utils"],
      "@/styles": ["template/src/styles"]
    }
  }
}
